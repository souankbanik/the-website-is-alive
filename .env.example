# Copy to .env.local for `npm run dev`, and set the same names in Vercel → Settings → Environment Variables.

# Password for /admin.html. Required - without it the visitor API refuses all admin requests.
ADMIN_PASSWORD=

# Upstash Redis (added automatically when you connect "Upstash for Redis" in the Vercel Marketplace).
# Leave empty locally to keep records in memory while the dev server runs.
KV_REST_API_URL=
KV_REST_API_TOKEN=
